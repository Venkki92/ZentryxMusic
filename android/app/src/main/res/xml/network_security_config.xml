<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow both HTTPS (including self-signed/user CAs) and local LAN HTTP Nextcloud servers -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Allow user-installed certificates for self-hosted Nextcloud instances -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
